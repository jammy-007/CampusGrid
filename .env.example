# Copy to .env at the repo root: cp .env.example .env

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://campusgrid:campusgrid@localhost:5432/campusgrid?schema=public"

# Auth: sign the cg_token JWT. Use a long random string outside local dev.
JWT_SECRET="change-me-to-a-long-random-string"

# QR pass signing keys (Ed25519 PKCS8/SPKI base64 or PEM). Required in production; dev falls back to an ephemeral pair.
# Generate fresh keys: node -e "const c=require('crypto'),{privateKey:p,publicKey:u}=c.generateKeyPairSync('ed25519');console.log('PASS_SIGNING_PRIVATE_KEY='+p.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('PASS_SIGNING_PUBLIC_KEY='+u.export({type:'spki',format:'der'}).toString('base64'));"
PASS_SIGNING_PRIVATE_KEY=""
PASS_SIGNING_PUBLIC_KEY=""

# GitHub API token for hackathon repo validation (Agent 4). Optional; raises rate limits.
GITHUB_TOKEN=""

# Where the browser connects for Socket.IO.
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# Public URL of the web app (used for links in certificates, CORS).
APP_URL="http://localhost:3000"

# Where the Next.js server proxies /api/* (defaults to http://localhost:4000).
API_URL="http://localhost:4000"

# Time zone dates are shown in (IANA name).
NEXT_PUBLIC_TIME_ZONE="Asia/Kolkata"
