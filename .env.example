# Copy to .env at the repo root: cp .env.example .env

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://campusgrid:campusgrid@localhost:5432/campusgrid?schema=public"

# Auth: sign the cg_token JWT. Use a long random string outside local dev.
JWT_SECRET="change-me-to-a-long-random-string"

# QR pass signing keys (Agent 2). Base64 or PEM, see docs/CONTRACT.md.
PASS_SIGNING_PRIVATE_KEY=""
PASS_SIGNING_PUBLIC_KEY=""

# GitHub API token for hackathon repo validation (Agent 4). Optional; raises rate limits.
GITHUB_TOKEN=""

# Where the browser connects for Socket.IO.
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# Public URL of the web app (used for links in certificates, CORS).
APP_URL="http://localhost:3000"

# Where the Next.js server proxies /api/* (defaults to http://localhost:4000).
API_URL="http://localhost:4000"
